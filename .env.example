# Copy to .env and fill in. Never commit .env.

# --- Upstream LLM providers (bring your own key) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Open WebUI <-> proxy trust ---
# Shared secret: Open WebUI signs forwarded user JWTs with it, the proxy verifies them.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SECRET_KEY=

# Comma-separated origins allowed to call the proxy
ALLOWED_ORIGINS=http://localhost:3000

# --- Appliance identity (appears in audit reports) ---
APPLIANCE_ID=
CLIENT_ORG_NAME=

# --- Monthly audit report delivery (Resend) ---
EMAIL_API_KEY=
EMAIL_SENDER=
OPERATOR_EMAIL=
