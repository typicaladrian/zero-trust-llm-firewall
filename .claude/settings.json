{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X DELETE *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(docker push *)"
    ],
    "allow": [
      "Bash(venv/Scripts/python.exe -m pytest *)",
      "Bash(venv/bin/python -m pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" guard_bash.py",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" stop_tests.py",
            "timeout": 180,
            "statusMessage": "Running fast test tier..."
          }
        ]
      }
    ]
  }
}
